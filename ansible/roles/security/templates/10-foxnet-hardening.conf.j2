# {{ ansible_managed }}
PermitRootLogin {{ 'no' if security_ssh_disable_root_login else 'prohibit-password' }}
PasswordAuthentication {{ 'no' if security_ssh_disable_password_auth else 'yes' }}
KbdInteractiveAuthentication no
X11Forwarding no
MaxAuthTries 4
